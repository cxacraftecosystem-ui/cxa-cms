/// How loudly a banner speaks. An ENUM rather than free text for the reason `SubmissionStatus` is one:
/// a mistyped tone in a string column falls through to whatever the renderer's default branch is, and
/// nothing tells anybody it happened.
///
/// The four map onto the `BadgeTone` pairings in components/ui/Badge.tsx, which is the ONLY place these
/// colours are decided — INFO → `info`, SUCCESS → `success`, WARNING → `warn`, URGENT → `error`. Every one
/// of those pairs a fill with a glyph and a word, because colour never carries meaning alone (contract
/// §11), and components/site/AnnouncementBar.tsx draws the band from that same table. Gold is not among
/// them: gold is marketing-only, and a banner is information.
///
/// ⚠ THESE FOUR STRINGS ARE RESTATED in app/api/studio/announcements/route.ts, in its `[id]` sibling and in
/// app/studio/announcements/AnnouncementManager.tsx, because a Zod enum cannot be derived from a Prisma
/// enum without pulling the Prisma client into a browser bundle. Adding a value here means adding it in all
/// three, and the band's `Record<AnnouncementTone, …>` is what makes forgetting the band a compile error.
enum AnnouncementTone {
  INFO
  SUCCESS
  WARNING
  URGENT
}

/// A site-wide notice: "Applications for the 2026 residency close on 30 September", "The Centre is
/// closed for Diwali".
///
/// ══════════════════════════════════════════════════════════════════════════════════════════════
/// A MODEL RATHER THAN A SECTION, BECAUSE IT IS NOT ON A PAGE. A `PageSection` belongs to one `Page`;
/// this appears in the site chrome above every page at once, so an editor sets it in one place and
/// takes it down in one place. Putting it in a section would mean adding the same block to nine pages
/// and remembering all nine when the deadline passes.
///
/// ⚠ VISIBILITY IS RESOLVED AT READ TIME, from `startsAt`/`endsAt`, exactly as lib/content.ts resolves
/// publication state for pages — and for the same reason. There is no cron here at all: a banner that
/// outlived its deadline because a scheduled job did not run is worse than no banner, because it is
/// the Centre stating something untrue on every page of its own site. `lib/content.ts` holds
/// `activeAnnouncementWhere(now)` and `isAnnouncementActive(row, now)` beside the page filters; every
/// read path uses one of them, so the three conditions are never spelled out twice.
///
/// The three conditions are ANDed and each is a separate fact:
///   • `isActive` is the editor's switch — off means "not now", whatever the dates say;
///   • `startsAt` is "not yet" (null = already);
///   • `endsAt` is "no longer" (null = indefinitely).
/// ══════════════════════════════════════════════════════════════════════════════════════════════
///
/// `isActive` AND `deletedAt` ARE NOT THE SAME SWITCH, which is why both are here. Turning a banner off is
/// "not now" and keeps it in the list to be turned back on; deleting it is "this was a mistake", and the
/// soft-delete convention at the top of this file applies unchanged — the studio's announcements screen
/// shows removed rows and restores them, and a restore brings the row back SWITCHED OFF so nothing
/// reappears on the site by pressing one button.
///
/// ⚠ `dismissible` MEANS A READER MAY CLOSE IT, and a dismissal is remembered on their own device,
/// keyed by this row's `id` — see components/site/AnnouncementBar.tsx. One consequence is worth knowing
/// before editing a live banner: correcting the text of an announcement somebody has already dismissed
/// does NOT bring it back for them, because the id has not changed. Where the correction matters —
/// a date that moved, a venue that changed — the honest move is a NEW announcement rather than an edit.
/// A non-dismissible banner renders no close button at all, rather than a dead one (contract §1.8).
model Announcement {
  id String @id @default(cuid())

  /// One or two sentences, as plain text. Deliberately not rich text: a banner is one line of chrome
  /// above every page on the site, and formatting inside it fights the header for attention.
  message   String
  /// Where the banner leads, if anywhere. Same shapes the section schemas accept — "/apply", an
  /// absolute URL, a "mailto:".
  href      String?
  /// The words on that link. A banner with an `href` and no label has nothing to click.
  linkLabel String?

  tone AnnouncementTone @default(INFO)

  /// The window, both ends optional. See the read-time warning above.
  startsAt DateTime?
  endsAt   DateTime?

  /// The editor's switch, independent of the dates.
  isActive    Boolean @default(true)
  /// May a reader close it? Off for something they must not be able to hide from themselves — a
  /// closure notice, a safety instruction.
  dismissible Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  createdBy User? @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  /// The public read is "not deleted, active, in window, newest first" — one index covering the switch and
  /// both ends of the window, and one for the recycle-bin split.
  @@index([isActive, startsAt, endsAt])
  @@index([deletedAt])
  @@map("announcements")
}

/// One row per settings GROUP ("branding", "contact", "social", "seo", "homepage", "features"), each
/// holding a JSON document validated by a Zod schema in lib/settings/schema.ts. A key/value table
/// with one row per field makes "read all branding settings" six round trips and gives the type
/// system nothing to check.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("settings")
}

enum SubmissionStatus {
  NEW
  IN_PROGRESS
  REPLIED
  ARCHIVED
  SPAM
}

model ContactSubmission {
  id           String           @id @default(cuid())
  name         String
  email        String
  organisation String?
  phone        String?
  subject      String?
  message      String
  /// Which form on the site produced this: "general" | "admissions" | "collaboration" | "media".
  formKey      String           @default("general")
  state        SubmissionStatus @default(NEW)
  assigneeId   String?
  internalNote String?
  repliedAt    DateTime?

  /// Anti-spam evidence, kept so a false positive can be explained rather than merely reversed.
  spamScore  Float?
  spamReason String?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  assignee User? @relation("InquiryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([state, createdAt])
  @@index([deletedAt])
  @@map("contact_submissions")
}

/// First-party analytics. Deliberately COARSE: a day bucket, a path, a country. No cookie, no
/// visitor id, no cross-site identifier — the numbers the Centre actually reports on are page views
/// and downloads, and collecting more than that to answer them is a liability with no upside.
model PageViewDaily {
  id      String   @id @default(cuid())
  day     DateTime @db.Date
  path    String
  country String?
  views   Int      @default(0)
  uniques Int      @default(0)

  @@unique([day, path, country])
  @@index([day])
  @@map("page_views_daily")
}

model DownloadEvent {
  id         String   @id @default(cuid())
  entityType String // "file" | "publication" | "dataset"
  entityId   String
  day        DateTime @db.Date
  country    String?
  count      Int      @default(0)

