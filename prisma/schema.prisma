  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  region CraftRegion? @relation(fields: [regionId], references: [id], onDelete: SetNull)
  school CraftSchool? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  cover  MediaAsset?  @relation("CraftCover", fields: [coverId], references: [id], onDelete: SetNull)
