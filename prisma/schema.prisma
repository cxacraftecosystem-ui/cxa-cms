  @@index([day])
  @@map("search_query_logs")
}

/// The global search index. One denormalised row per publishable entity, rebuilt on write by
/// lib/search/index.ts. `body` is plain text — the searchable prose with markup stripped — so a
/// query never matches a JSON key name from a Tiptap document.
model SearchDocument {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  title       String
  summary     String?
  body        String   @default("")
  url         String
  keywords    String[] @default([])
  /// Denormalised so results can be filtered without joining six tables, and so an unpublished row
  /// can be excluded by the index itself rather than by every caller remembering to.
  isPublished Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([isPublished])
  @@index([entityType])
  @@map("search_documents")
}

/// Editor-managed redirects, so moving a page never has to break an existing citation.
model Redirect {
  id          String   @id @default(cuid())
  source      String   @unique
  destination String
  permanent   Boolean  @default(true)
  hits        Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("redirects")
}

// ═══════════════════════════════════════════════════════════════════════════
// The newsletter
//
// Two tables and three enums, and the shape is decided by four facts about this feature that are
// worth stating before any column is read:
//
//   1. SUBSCRIBING IS A DOUBLE OPT-IN. A POST creates a PENDING row; only a confirmation link that
//      was actually clicked promotes it to CONFIRMED. So "the row exists" and "this person asked to
//      hear from us" are two different statements, and only `status` carries the second one. Every
//      read that means "who would a mailing go to" must therefore filter on
//      `status = CONFIRMED`, never on the presence of a row.
//
//   2. UNSUBSCRIBING IS NOT DELETING, AND THAT IS THE WHOLE POINT OF KEEPING THE ROW. An
//      UNSUBSCRIBED row is a SUPPRESSION RECORD: it is the evidence that this address asked to be
//      left alone, and deleting it would mean the next import or the next sign-up form has no way
//      to know. `deletedAt` is a different act entirely — an erasure request, where the person has
//      asked to be forgotten rather than merely left alone — and it is rarer, deliberate, and the
//      only one that loses the suppression.
//
//   3. THE CONSENT RECORD IS EVIDENCE AND IS THEREFORE COPIED, NOT REFERENCED. `consentText` holds
//      the sentence the person actually read, in full, at the moment they agreed to it. It is NOT a
//      pointer at whatever the current wording happens to be: editing the wording next year must not
//      silently rewrite what everybody who signed up this year is recorded as having agreed to.
//      `consentVersion` is kept alongside it so a whole cohort can be found, and lib/newsletter/
//      consent.ts is the register that maps a version back to its text.
//
//   4. DELIVERY IS A SEAM, NOT A FEATURE OF THIS SCHEMA. No provider is configured in this
//      deployment, so `NewsletterDelivery` is an OUTBOX: one row per message this application
//      decided to send, whether or not anything sent it. A PENDING subscriber with a RECORDED
//      confirmation row is a person waiting for an email nobody has sent yet — which is a fact the
//      studio can show and act on, and is exactly what would otherwise be invisible.
// ═══════════════════════════════════════════════════════════════════════════

/// Where a subscription stands. Deliberately three values and not a boolean pair: "asked but has not
/// confirmed" and "confirmed" are different rights, and "unsubscribed" is a third thing again — an
/// instruction that must survive, not an absence.
enum SubscriberStatus {
  /// Signed up, not yet confirmed. NEVER mailed anything except the confirmation itself.
  PENDING
  /// Clicked the confirmation link. The only status a mailing may go to.
  CONFIRMED
  /// Asked to stop. The row is KEPT as the record of that instruction — see fact 2 above.
  UNSUBSCRIBED
}

/// Which message the outbox row is about. A message a person receives is never a free-text string
/// here, because every kind has different rules about when it may be sent at all.
enum NewsletterMailKind {
  /// The double opt-in link. The only thing a PENDING subscriber is ever sent.
  CONFIRMATION
  /// "You are already subscribed" — the answer to a repeat sign-up for a CONFIRMED address. It exists
  /// so the PUBLIC response can stay identical for every address (the route never says whether an
  /// address is known) while the person themselves still finds out what happened.
  ALREADY_SUBSCRIBED
  /// Sent once, after a confirmation succeeds.
  WELCOME
  /// Confirms an unsubscribe took effect, so nobody has to wonder whether the link worked.
  UNSUBSCRIBE_RECEIPT
}

/// What happened to an outbox row.
enum NewsletterMailState {
  /// Written down, nothing sent. The DEFAULT, and the honest state of every row in a deployment with
  /// no mail provider registered. See the header of lib/newsletter/delivery.ts.
  RECORDED
  /// A registered provider accepted it.
  SENT
  /// A registered provider refused or threw. `error` says what it said.
  FAILED
}

/// One address that asked to hear from the Centre.
model NewsletterSubscriber {
  id String @id @default(cuid())

  /// The address AS THE PERSON TYPED IT, preserved for display and for the envelope. The local part
  /// of an address is case-sensitive by RFC 5321 even though effectively every provider treats it
  /// otherwise, so the capitals somebody chose are kept rather than thrown away.
  email    String
  /// The normalised form, and the ONE thing uniqueness is decided on — trimmed, Unicode-NFC, then
  /// lower-cased whole. `lib/newsletter/address.ts` is the only implementation and its header sets
  /// out precisely what is and is not folded (dots and `+tags` are NOT, deliberately).
  ///
  /// ⚠ Every lookup, every token and every suppression check keys on THIS column. Querying `email`
  /// would make `Reader@example.org` and `reader@example.org` two different people.
  emailKey String @unique

  status SubscriberStatus @default(PENDING)

  /// ── Double opt-in ───────────────────────────────────────────────────────────────────────────
  /// A random nonce that the emailed confirmation link's signature covers. It is NOT the credential
  /// on its own — the link carries a signed envelope (lib/newsletter/tokens.ts) and this is the half
  /// that makes the link SINGLE USE: confirming clears it, and re-issuing a link replaces it, so an
  /// old link in an old mailbox stops working the moment a newer one is sent.
  confirmationToken     String?
  /// When that link stops being accepted. Enforced in the signed envelope AND against this column, so
  /// neither a forged expiry nor a stale row can extend it.
  confirmationExpiresAt DateTime?
  /// When a confirmation message was last handed to the delivery seam. The cooldown that stops this
  /// form being used to post one message a second at somebody else's inbox is measured from here.
  confirmationSentAt    DateTime?

  confirmedAt    DateTime?
  unsubscribedAt DateTime?

  /// ── Where they signed up ────────────────────────────────────────────────────────────────────
  /// A short key naming the surface that produced this row — "newsletter-page", "footer". Chosen from
  /// `NEWSLETTER_SOURCES` in lib/newsletter/address.ts rather than free text, so the studio's filter
  /// is a closed list and one typo cannot create a second, near-identical source.
  source     String  @default("newsletter-page")
  /// The exact path the form was on, when the surface knows it. Free text, because a form in the
  /// footer appears on every page and "which page were they reading" is the useful half of provenance.
  sourcePath String?

  /// ── The consent record ──────────────────────────────────────────────────────────────────────
  /// The sentence they agreed to, VERBATIM. Copied, never referenced — see fact 3 in the header.
  consentText    String
  /// Which wording that was, so a cohort can be found without string-matching prose.
  consentVersion String
  /// When they agreed. Distinct from `createdAt`: an UNSUBSCRIBED address that signs up again keeps
  /// its row and gets a NEW consent stamp, and `createdAt` would still be the first time.
  consentAt      DateTime

  /// Evidence of the act, for a consent challenge. Same fields the contact form keeps, and kept for
  /// the same reason: "prove they asked" is unanswerable without them.
  ipAddress String?
  userAgent String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// The erasure request. ⚠ NOT the unsubscribe — see fact 2. Every read path filters on it.
  ///
  /// ⚠ THIS MODEL IS NOT IN THE RECYCLE BIN's registry (app/api/studio/recycle-bin/route.ts), so a
  /// soft-deleted subscriber is not restorable from that screen. The studio's subscribers screen
  /// states the count of removed records rather than letting them vanish silently; adding the model
  /// to the registry is a two-line change and is written up in this session's handover.
  deletedAt DateTime?

  deliveries NewsletterDelivery[]

  /// The studio list is "not deleted, optionally one status, newest first"; the second index is the
  /// recycle-bin split, matching every other soft-deleted model here.
  @@index([status, createdAt])
  @@index([deletedAt])
  @@index([source])
  @@map("newsletter_subscribers")
}

/// THE OUTBOX. One row per message this application decided to send.
///
/// ⚠ IT DELIBERATELY DOES NOT STORE THE LINK. A confirmation URL is a credential, and a table that
/// holds one turns every database read, every backup and every export into a way to confirm somebody
/// else's subscription. It does not need to: the token is DERIVED (lib/newsletter/tokens.ts), so a
/// replay of this outbox rebuilds the link from `emailKey` and `kind` at the moment it is finally
/// sent — which also gives the recipient a fresh expiry instead of one that lapsed while the row sat
/// here waiting for a provider.
model NewsletterDelivery {
  id String @id @default(cuid())

  /// Null once the subscriber row has been erased. The message still happened, so the record stays.
  subscriberId String?
  /// Denormalised, so a delivery row remains readable after an erasure and so the outbox can be
  /// searched without a join.
  emailKey     String

  kind  NewsletterMailKind
  state NewsletterMailState @default(RECORDED)

  /// The subject line as composed. Held so the studio's outbox reads as messages rather than as ids.
  subject  String
  /// Which provider handled it — null for every RECORDED row, by definition.
  provider String?
  /// What a provider said when it refused. Null unless `state` is FAILED.
  error    String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  subscriber NewsletterSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  /// "What is still waiting to be sent, oldest first" is the query the studio banner runs.
  @@index([state, createdAt])
  @@index([emailKey])
  @@index([subscriberId])
  @@map("newsletter_deliveries")
}
