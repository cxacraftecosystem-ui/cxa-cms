// ─────────────────────────────────────────────────────────────────────────────
// CxA Centre of Excellence — data model
//
// The shape is a HYBRID, not a table-per-page CMS:
//
//   • `Page` owns routing, SEO and publication state.
//   • `PageSection` owns ORDERED, TYPED content blocks whose payload is JSON, so a new homepage
//     section or a new layout is a new `SectionType` value and a renderer — never a migration.
//   • Everything a researcher actually curates (people, projects, publications, news, events,
//     crafts, media) is a first-class relational table, because those are queried, filtered,
//     sorted and cited. Burying them in JSON would make "publications by year, by author" a
//     full-table scan over a document blob.
//
// Two conventions run through the whole file:
//
//   1. SOFT DELETE. Content models carry `deletedAt`; nothing user-facing is ever hard-deleted by
//      the CMS. The recycle bin is `deletedAt IS NOT NULL`, and a purge job is the only writer of
//      a real DELETE. Every read path MUST filter on it — use `livePublishableWhere()` or
//      `liveStatusWhere()` from lib/content.ts, which exist so no call site hand-rolls that filter
//      and forgets it once. They are two functions and not one on purpose: referencing a column a
//      model does not have (publishAt/unpublishAt) is a Prisma runtime error, not a type error.
//   2. AUDITED MUTATION. Every write goes through lib/audit.ts, which writes the row AND an
//      `AuditLog` entry inside ONE transaction. A log that can be written without the change (or
//      the reverse) is a log nobody can trust during an incident.
//
// Decimal note (field-repo-frontend §1.9): Prisma `Decimal` arrives over JSON as a STRING. Nothing
// in this schema uses Decimal for exactly that reason — money and coordinates are Float/Int, and
// where precision matters the value is stored as a string with its unit alongside.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// Identity, access and the audit trail
// ═══════════════════════════════════════════════════════════════════════════

/// Six tiers, strictly ordered, mirroring the Field Repository ladder in backend/app/core/deps.py.
/// The numeric ranks live in lib/permissions.ts as the single source of comparison; adding a tier
/// means adding it there too, and NOWHERE else — a second hand-rolled rank test that disagrees with
/// the first is how a "professor may edit anyone below" rule silently stops matching.
enum Role {
  VIEWER // 10 — read the CMS, change nothing
  AUTHOR // 20 — draft own content, cannot publish
  MEDIA_MANAGER // 30 — the media library and files, plus AUTHOR
  RESEARCHER // 40 — research, projects, publications; publish own
  EDITOR // 50 — publish anything, edit anyone's content
  ADMINISTRATOR // 60 — users, settings, navigation, restore, purge
  /// 70 — who may enter the studio AT ALL, plus the provenance console.
  ///
  /// Deliberately ABOVE administrator rather than beside it. An administrator manages the site; a master
  /// admin manages who is allowed near it. Keeping the two apart means the day-to-day administrator
  /// account — the one actually used, and therefore the one most likely to be compromised — cannot widen
  /// the circle of people who can sign in.
  MASTER_ADMIN
}

/// How somebody proved who they are. Recorded on the allow-list and on every sign-in event.
enum AuthProvider {
  PASSWORD
  GOOGLE
  MICROSOFT
  YAHOO
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String?
  role         Role    @default(VIEWER)
  avatarId     String?
  title        String?
  isActive     Boolean @default(true)

  /// Per-user grants that WIDEN a role, never narrow it. lib/permissions.ts ORs them into the rank
  /// test; a grant is therefore additive and a demotion always takes effect immediately.
  canPublish     Boolean @default(false)
  canManageMedia Boolean @default(false)

  /// TOTP. `twoFactorSecret` is encrypted at rest by lib/auth/totp.ts — a plaintext shared secret in
  /// the database means a database read is a full account takeover, which is the one thing 2FA is
  /// bought to prevent.
  twoFactorEnabled       Boolean  @default(false)
  twoFactorSecret        String?
  /// Single-use recovery codes, stored as bcrypt hashes. Never rendered again after issue.
  twoFactorRecoveryCodes String[] @default([])

  lastLoginAt  DateTime?
  failedLogins Int       @default(0)
  /// Set by the throttle in lib/auth/session.ts. Compared server-side only.
  lockedUntil  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  avatar              MediaAsset?         @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  sessions            Session[]
  auditLogs           AuditLog[]
  revisions           Revision[]
  locks               ContentLock[]
  authoredPosts       Post[]              @relation("PostAuthor")
  uploadedMedia       MediaAsset[]        @relation("MediaUploader")
  uploadedFiles       FileAsset[]         @relation("FileUploader")
  assignedInquiries   ContactSubmission[] @relation("InquiryAssignee")
  oauthAccounts       OAuthAccount[]
  accessGrantsAdded   StudioAccess[]      @relation("AccessAddedBy")
  accessGrantsRevoked StudioAccess[]      @relation("AccessRevokedBy")
  announcements       Announcement[]      @relation("AnnouncementAuthor")

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

/// Is one `StudioAccess` row one PERSON, or everybody at an organisation?
///
/// EMAIL is one address and nothing else. DOMAIN is "anybody whose address ends in this domain" — the
/// grant an institution actually wants when every colleague is at @iitkgp.ac.in and adding them one at a
/// time means the list is out of date the week somebody joins.
///
/// ⚠ THE DEFAULT IS EMAIL, AND IT HAS TO BE. Every row written before this column existed is one address;
/// a default of DOMAIN would have turned each of them, in one migration and with no audit entry, into a
/// standing grant for everybody at that person's mail provider — @gmail.com included.
enum AccessKind {
  EMAIL
  DOMAIN
}

/// The studio allow-list: the addresses — and the whole domains — permitted to sign in at all.
///
/// ══════════════════════════════════════════════════════════════════════════════════════════════
/// IT IS AN AUTHORISATION GATE, NOT A CONVENIENCE. Every sign-in path — password, Google, Microsoft,
/// Yahoo — consults it BEFORE a session is issued and before an account is created. Without it, adding
/// "Continue with Google" would mean anybody on earth with a Google account could open the CMS, because
/// an OAuth provider answers "who is this?" and never "should they be here?".
///
/// A row is a STANDING GRANT rather than a one-time invitation, which is why it survives being used:
/// revoking access is deleting or revoking the row, and it takes effect on the next sign-in. A used
/// invitation that vanished would leave no record of who let somebody in.
///
/// `grantedRole` is the role the account is created with on FIRST sign-in. It does not follow later
/// changes — an administrator may promote or demote the user afterwards, and re-reading this row would
/// silently undo that on their next visit.
///
/// ⚠ A DOMAIN GRANT IS THE WIDEST THING ANYBODY CAN WRITE IN THIS PRODUCT. "@iitkgp.ac.in" admits every
/// present and future holder of an address there, at `grantedRole`, without a master admin ever seeing
/// their name. That is the point of it — and it is why lib/auth/access.ts consults domain grants only
/// AFTER an exact address has failed to match, and why one typed at a public mail provider would open
/// the CMS to the world. The screen says so where the box is.
/// ══════════════════════════════════════════════════════════════════════════════════════════════
model StudioAccess {
  id    String     @id @default(cuid())
  /// The identity of the row, stored lower-cased, whichever kind it is: an ADDRESS ("ada@example.org")
  /// when `kind` is EMAIL, or a DOMAIN CARRYING ITS LEADING "@" ("@iitkgp.ac.in") when it is DOMAIN.
  ///
  /// ══════════════════════════════════════════════════════════════════════════════════════════════
  /// ONE COLUMN FOR BOTH, AND NOT A SECOND NULLABLE `domain` COLUMN. The alternative was considered and
  /// is worse in three specific ways:
  ///
  ///  • UNIQUENESS. Postgres does not compare NULLs, so `email` and `domain` as two nullable unique
  ///    columns cannot express "this row is listed exactly once" — a domain could be added twice as
  ///    (NULL, '@x.ac.in') and the index would permit both, which is a coin toss over which grant the
  ///    sign-in path finds and therefore over what role somebody gets. Here the one index already does it.
  ///  • EVERY READER. `entityLabel` in the audit log, the duplicate 409, the sign-out lookup, the
  ///    console's row label and `resolveAccess` itself all read one identity string today. A second
  ///    column makes every one of them a two-branch expression, and the branch somebody forgets is the
  ///    one that logs an empty label against the widest grant on the list.
  ///  • COLLISION. The "@" is stored, not stripped, so a domain key can never equal an address key: a
  ///    real address always has a local part in front of its "@". The two namespaces share an index
  ///    without being able to shadow one another.
  ///
  /// `kind` is therefore the ANSWER, not a duplicate of it — and lib/auth/access.ts requires it to agree
  /// with the shape before honouring a domain match, so a hand-edited row fails closed rather than open.
  /// ══════════════════════════════════════════════════════════════════════════════════════════════
  email String     @unique
  kind  AccessKind @default(EMAIL)

  /// A name to show before the person has ever signed in, so the list reads as people rather than
  /// addresses. On a DOMAIN row it is the organisation ("IIT Kharagpur"), never a person.
  name        String?
  grantedRole Role    @default(AUTHOR)
  /// Why this person has access. Free text, shown in the console — an access list with no reasons is one
  /// nobody dares prune.
  note        String?

  /// Which sign-in methods this address — or everybody at this domain — may use. Empty means "any
  /// configured method". Narrowing a DOMAIN row to GOOGLE is how "our staff sign in with their
  /// institutional Google accounts, and a password is not a second door" is expressed.
  allowedProviders AuthProvider[] @default([])

  addedById   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Set rather than deleted, so the trail of who was once allowed in survives.
  revokedAt   DateTime?
  revokedById String?

  /// Stamped by the sign-in path. Answers "is this grant still used?", which is the question that makes
  /// an access list prunable.
  lastSignInAt DateTime?
  lastProvider AuthProvider?
  signInCount  Int           @default(0)

  addedBy   User? @relation("AccessAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  revokedBy User? @relation("AccessRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([revokedAt])
  /// ⚠ NO INDEX ON `kind`, DELIBERATELY. Every lookup that matters — the exact address and the domain
  /// key alike — goes through the unique index on `email`, because a domain is stored as a key ("@x.ac.in")
  /// and not derived at query time. A two-value enum on a table with tens of rows is the textbook case
  /// where the planner picks a sequential scan anyway, so the index would be write cost for nothing.
  @@map("studio_access")
}

/// A linked external identity.
///
/// Separate from `User` because one person may sign in with a password AND with Google, and because the
/// provider's own identifier — not the email — is the stable key. An email can be reassigned inside an
/// organisation; `sub` cannot.
model OAuthAccount {
  id                String       @id @default(cuid())
  provider          AuthProvider
  /// The provider's `sub` claim. Stable for the life of the account, unlike the email.
  providerAccountId String
  userId            String
  /// The address the provider asserted at link time, for display and for audit. NEVER used to find the
  /// account — see `providerAccountId`.
  email             String
  createdAt         DateTime     @default(now())
  lastUsedAt        DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// A refresh-token family. The token itself is NEVER stored — only a SHA-256 hash — so a database
/// leak cannot be replayed as a login. Rotation replaces the row and sets `rotatedTo`; a reuse of a
/// rotated token means the family is compromised and lib/auth/session.ts revokes the whole chain.
model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  familyId         String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  rotatedTo        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  PUBLISH
  UNPUBLISH
  ARCHIVE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PERMISSION_CHANGE
  UPLOAD
  PURGE
  ROLLBACK
}

/// Who, when, what, old value, new value. `before`/`after` hold the FULL serialised entity rather
/// than a diff: a diff computed at write time is only as good as the differ that produced it, and a
/// rollback needs the whole prior state anyway.
model AuditLog {
  id          String      @id @default(cuid())
  actorId     String?
  actorEmail  String? // denormalised so a deleted user does not erase the trail
  action      AuditAction
  entityType  String
  entityId    String?
  entityLabel String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Unlimited revisions for every versioned entity. Polymorphic on (entityType, entityId) rather than
/// one revision table per model — a per-model table would mean a migration for every new content
/// type, which is precisely what the section model exists to avoid.
model Revision {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  version    Int
  data       Json
  summary    String?
  authorId   String?
  createdAt  DateTime @default(now())

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId, createdAt])
  @@map("revisions")
}

/// "Someone else is editing this." Advisory, with a HARD EXPIRY: a lock that outlives the tab that
/// took it would strand content forever, and an editor who force-takes a lock is recorded rather
/// than blocked. `expiresAt` is refreshed by a heartbeat while the editor is open.
model ContentLock {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  userId     String
  acquiredAt DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId])
  @@index([expiresAt])
  @@map("content_locks")
}

// ═══════════════════════════════════════════════════════════════════════════
// Pages and the typed section model
// ═══════════════════════════════════════════════════════════════════════════

/// Every renderable block type. Adding one is: a value here, a Zod schema in lib/sections/schema.ts,
/// a renderer in components/sections/, and an editor form in components/studio/sections/. No
/// migration, because the payload is `PageSection.data`.
enum SectionType {
  HERO
  RICH_TEXT
  STATS
  FEATURE_GRID
  RESEARCH_SHOWCASE
  PROJECT_SHOWCASE
  PEOPLE_SHOWCASE
  PUBLICATION_LIST
  NEWS_SHOWCASE
  EVENT_SHOWCASE
  GALLERY
  MEDIA_SPLIT
  TIMELINE
  PARTNER_LOGOS
  QUOTE
  CTA
  FAQ
  CONTACT_FORM
  MAP
  EMBED
  DOWNLOADS
  CRAFT_EXPLORER
  SPACER
  /// ── Appended, and appended DELIBERATELY AT THE END ───────────────────────
  /// A Postgres enum value added after the last one is a plain `ALTER TYPE … ADD VALUE`; inserting it
  /// next to the block it reads like a cousin of would need `… BEFORE 'SPACER'`, which is the same
  /// migration with one more way to get it wrong. Reading order is what `SECTION_REGISTRY`'s groups
  /// are for — nothing on screen is ordered by this enum.
  ///
  /// The three below exist so an editor can build an application page — the steps, the form and the
  /// resources — without a developer.
  ACTION_STEPS
  FORM_EMBED
  LINK_GRID
  /// ── The narrative blocks ─────────────────────────────────────────────────
  /// Appended at the end for the same reason as the three above.
  ///
  /// These four are the ones that let a page TELL something rather than list it, and they are the
  /// only blocks whose motion is scroll-scrubbed rather than an entrance (components/motion/gsap).
  /// Every one of them is a complete, readable section with JavaScript switched off and under
  /// reduced motion — the scrubbing is an enhancement of a layout that already works, never the
  /// thing that makes the layout make sense. See components/motion/gsap/runtime.ts for why that
  /// line is drawn where it is.
  STORY_SCROLL
  PARALLAX_BANNER
  HORIZONTAL_RAIL
  PROCESS_STEPS
  /// The platform, in three instruments — knowledge bases, field repositories and knowledge-based
  /// systems — as three fixed, designed vignettes, each dominated by its own scroll-scrubbed
  /// drawing. Appended at the end for the same ALTER TYPE reason as everything above it.
  PLATFORM_PILLARS
  /// The outline of India (the official depiction — see components/map/indiaGeometry.ts) with a
  /// pin per craft region, counted from the published archive. Appended at the end, as ever.
  INDIA_MAP
  /// One uploaded document shown where an editor put it: a PDF in a frame on the page, anything else
  /// as a download card naming the file, its type and its size. Appended at the end, as ever.
  ///
  /// It names a `MediaAsset`, NOT a `FileAsset`, and the reason is in `documentEmbedSectionSchema`
  /// (lib/sections/schema.ts): the file store serves every version with `Content-Disposition:
  /// attachment`, which a browser downloads rather than draws, so a frame pointed at it would leave
  /// an empty box on the page. Media assets are served from the public object base with no such
  /// header, and `app/api/studio/media/presign` already accepts PDFs and PowerPoint files.
  DOCUMENT_EMBED
}

model Page {
  id       String  @id @default(cuid())
  /// Full path WITHOUT a leading slash: "" is the homepage, "about", "research/roadmap".
  /// Uniqueness is on the path, so two pages can never claim one URL.
  slug     String  @unique
  title    String
  /// Optional shorter label for navigation and breadcrumbs.
  navLabel String?

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  /// Scheduled publishing. A cron (app/api/cron/publish) flips SCHEDULED → PUBLISHED at publishAt
  /// and PUBLISHED → ARCHIVED at unpublishAt. Both are checked at READ time too, so a stalled cron
  /// cannot leave an expired page live.
  publishAt   DateTime?
  unpublishAt DateTime?

  // SEO
  seoTitle       String?
  seoDescription String?
  seoImageId     String?
  seoNoIndex     Boolean @default(false)
  canonicalUrl   String?

  /// Locks a page against deletion in the CMS. Set on structural pages (home, about, contact) whose
  /// route is referenced by the code; deleting one would 404 a link the site itself renders.
  isSystem  Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  seoImage MediaAsset?   @relation("PageSeoImage", fields: [seoImageId], references: [id], onDelete: SetNull)
  sections PageSection[]

  @@index([status, publishedAt])
  @@index([deletedAt])
  @@map("pages")
}

model PageSection {
  id        String      @id @default(cuid())
  pageId    String
  type      SectionType
  /// Dense 0-based ordering maintained by the builder. Reordering rewrites the affected range in one
  /// transaction rather than issuing N independent updates, so a failed drag cannot leave two
  /// sections claiming one position.
  position  Int
  /// Editor-facing name. Never rendered — it exists so a builder row says "Hero — Autumn campaign"
  /// instead of "HERO".
  label     String?
  /// The block's payload. Validated against the Zod schema for `type` on every write; a block whose
  /// payload does not parse is rendered as an editor-only error card, never as a blank gap.
  data      Json        @default("{}")
  isVisible Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, position])
  @@index([pageId])
  @@map("page_sections")
}

/// A page ARRANGEMENT an administrator can create, rename and edit — the editable half of
/// lib/page-templates.ts.
///
/// ═══════════════════════════════════════════════════════════════════════════
/// ⚠ A TEMPLATE ROW HOLDS BLOCK TYPES, NEVER BLOCK PAYLOADS, AND THAT IS THE WHOLE DESIGN.
///
/// `blocks` is an ordered list of `{ type, label, purpose, overrides }` — never a copy of a page's
/// content. Every payload is still built at the moment of use by `defaultSectionData()` and then
/// validated by `parseSectionData()`, exactly as it was when the six built-in arrangements were the
/// only ones there were. Two properties follow, and both are why this table is shaped like this
/// rather than storing a page to clone:
///
///   • A template CANNOT GO STALE. When a block's schema gains a field or changes a default, every
///     template — including one an administrator wrote eighteen months ago — follows on its next
///     use. A table of stored payloads would keep handing out last release's shape forever.
///   • Every payload is VALID BY CONSTRUCTION, so a template can never produce the editor-only
///     error card that an unparseable `PageSection.data` renders as.
///
/// `overrides` is the narrow exception, and it is merged over the seed and RE-PARSED — so an
/// override naming a field that no longer exists is stripped by `z.object()` rather than failing.
/// A template can lose a nicety across a schema change; it can never produce an invalid page.
///
/// SHADOWING A BUILT-IN: `key` matching one of the ids in `PAGE_TEMPLATES` makes this row REPLACE
/// that arrangement everywhere it is offered. That is how "edit an existing template" works without
/// a migration per edit, and `isHidden` is how one is retired without deleting the code that
/// describes it. A row with a key matching no built-in is simply a new template.
/// ═══════════════════════════════════════════════════════════════════════════
model PageTemplate {
  id String @id @default(cuid())

  /// Stable and URL-safe: it travels in a form field and is matched against the built-in list on the
  /// way back. Unique across custom rows AND shadowed built-ins, because two arrangements answering
  /// to one key would make the second unreachable.
  key String @unique

  /// A noun phrase, as an administrator would name the thing they are about to make.
  name           String
  /// Two sentences: what this arrangement is for, and when to reach for it instead of a blank page.
  description    String
  /// Pre-filled into the title field, so the form is never a blank box with no hint of what goes in it.
  suggestedTitle String
  /// A `lucide-react` export name, as a string. A name lucide no longer exports resolves to a plain
  /// square on screen rather than throwing — lucide has renamed whole families before.
  icon           String

  /// The ordered block specs. See the warning above: TYPES AND LABELS, NEVER PAYLOADS.
  blocks Json @default("[]")

  /// Retire an arrangement without deleting it. A hidden row that shadows a built-in also hides the
  /// built-in, which is the only way to withdraw one of those.
  isHidden  Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete, like every other content table — so a template deleted by accident is in the
  /// recycle bin rather than gone, and `key` can be reclaimed only after a purge.
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([isHidden, sortOrder])
  @@map("page_templates")
}

// ═══════════════════════════════════════════════════════════════════════════
// Media, files and the derivative pipeline
// ═══════════════════════════════════════════════════════════════════════════

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  MODEL_3D
  PANORAMA
}

model MediaFolder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  path      String   @unique // materialised "/events/2026/convocation" — one query for a subtree
  createdAt DateTime @default(now())

  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MediaFolder[] @relation("FolderTree")
  assets   MediaAsset[]

  @@index([parentId])
  @@map("media_folders")
}

model MediaAsset {
  id          String    @id @default(cuid())
  kind        MediaKind
  /// Storage key of the ORIGINAL upload. Originals are retained forever: a derivative pipeline that
  /// has thrown the source away can never be re-run with better settings.
  objectKey   String    @unique
  fileName    String
  mimeType    String
  byteSize    Int
  width       Int?
  height      Int?
  /// Seconds, for video/audio.
  duration    Float?
  /// SHA-256 of the bytes. The duplicate detector compares THIS, never the filename — "IMG_0421.jpg"
  /// collides constantly and identical bytes almost never do.
  checksum    String?
  /// Tiny base64 LQIP used as next/image `blurDataURL`. Generated once at upload.
  blurDataUrl String?

  /// The part of the picture the site shows, as fractions of the FULL image (0–1), origin at the
  /// top left. All five are null together and null means "no crop chosen — show the whole thing".
  /// Applied at RENDER by components/ui/MediaImage.tsx; the stored bytes are never touched, so a
  /// crop is adjustable for ever and costs no re-upload. See the migration for why.
  cropX      Float?
  cropY      Float?
  cropWidth  Float?
  cropHeight Float?
  /// The preset the editor picked ("16-9", "1-1", "free", …), kept only so the cropper reopens on
  /// the shape they chose. Nothing renders from it — the four numbers above are the truth.
  cropAspect String?

  altText   String?
  caption   String?
  credit    String?
  copyright String?
  tags      String[] @default([])

  folderId   String?
  uploaderId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete with a recovery window. lib/storage/purge.ts is the only thing that removes bytes,
  /// and only for rows soft-deleted longer than MEDIA_PURGE_AFTER_DAYS.
  deletedAt DateTime?

  folder      MediaFolder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploader    User?                 @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  variants    MediaVariant[]
  collections MediaCollectionItem[]

  // Back-relations. Every one is `onDelete: SetNull` at the referring side: removing a photograph
  // must never cascade into deleting the article that used it.
  userAvatars        User[]         @relation("UserAvatar")
  pageSeoImages      Page[]         @relation("PageSeoImage")
  personPhotos       Person[]       @relation("PersonPhoto")
  projectCovers      Project[]      @relation("ProjectCover")
  projectGallery     ProjectMedia[]
  postCovers         Post[]         @relation("PostCover")
  eventCovers        CoeEvent[]     @relation("EventCover")
  eventGallery       EventMedia[]
  partnerLogos       Partner[]      @relation("PartnerLogo")
  craftImages        CraftMedia[]
  craftCovers        Craft[]        @relation("CraftCover")
  albumCovers        GalleryAlbum[] @relation("AlbumCover")
  albumItems         GalleryItem[]
  researchAreaCovers ResearchArea[] @relation("ResearchAreaCover")

  @@index([kind])
  @@index([folderId])
  @@index([checksum])
  @@index([deletedAt])
  @@map("media_assets")
}

/// A generated derivative. Rows are created by lib/storage/derivatives.ts; the ORIGINAL is never a
/// variant row, so "delete every variant and regenerate" is always safe.
model MediaVariant {
  id        String   @id @default(cuid())
  assetId   String
  /// "thumb" | "sm" | "md" | "lg" | "xl" | "og"
  label     String
  format    String // "webp" | "avif" | "jpeg"
  objectKey String   @unique
  width     Int
  height    Int
  byteSize  Int
  createdAt DateTime @default(now())

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, label, format])
  @@index([assetId])
  @@map("media_variants")
}

model MediaCollection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  items MediaCollectionItem[]

  @@map("media_collections")
}

model MediaCollectionItem {
  collectionId String
  assetId      String
  position     Int

  collection MediaCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  asset      MediaAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([collectionId, assetId])
  @@index([collectionId, position])
  @@map("media_collection_items")
}

/// Documents, datasets, slide decks, ZIPs — anything downloaded rather than rendered.
/// Versioned: replacing a dataset issues a new `FileVersion` and leaves the old bytes reachable, so
/// a citation of "v2 of the Bagru corpus" does not silently start resolving to v3.
model FileAsset {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  description   String?
  category      String?
  /// Nobody outside the CMS may download it until this is true.
  isPublic      Boolean   @default(false)
  /// Optional link expiry for embargoed material. Enforced server-side at the download route, not by
  /// hiding the button — a hidden button is not an access control.
  expiresAt     DateTime?
  downloadCount Int       @default(0)
  uploaderId    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  uploader User?         @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  versions FileVersion[]
  projects ProjectFile[]

  @@index([deletedAt])
  @@map("file_assets")
}

model FileVersion {
  id        String   @id @default(cuid())
  fileId    String
  version   Int
  objectKey String   @unique
  fileName  String
  mimeType  String
  byteSize  Int
  checksum  String?
  notes     String?
  createdAt DateTime @default(now())

  /// A PDF rendition of this version, for a format no browser can draw. Null for a PDF — which needs
  /// none, being the thing everything else is converted INTO — and null for one never converted.
  previewObjectKey    String?   @unique
  previewByteSize     Int?
  /// When the last conversion attempt finished, whether it produced anything or not.
  previewAttemptedAt  DateTime?
  /// Why the last attempt produced nothing. Null when it succeeded, and null when none was ever made.
  ///
  /// ⚠ THERE IS DELIBERATELY NO `previewState` COLUMN. The state is derivable from these three and a
  /// fourth column could contradict them: `previewObjectKey` set means there is a preview,
  /// `previewFailedReason` set means the last attempt failed, and `previewAttemptedAt` null means nobody
  /// has tried. A stored state is a value that has to be written correctly in five places instead of
  /// read correctly in one, and the first time it disagreed the studio would offer to convert a document
  /// it had already converted.
  previewFailedReason String?

  file FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, version])
  @@map("file_versions")
}

// ═══════════════════════════════════════════════════════════════════════════
// People
// ═══════════════════════════════════════════════════════════════════════════

/// The groups the roster is divided into. Adding one is a value here, a migration, and a set of
/// hand-written mirrors in TypeScript. Most of them announce themselves: a `Record<PersonKind, …>`
/// (`PERSON_KIND_LABELS` and `_GROUPS` in components/site/PersonCard.tsx, `GROUP_LABELS` in
/// app/api/studio/people/reorder/route.ts) and a tuple with `satisfies readonly PersonKind[]` (the
/// `PERSON_KINDS` in the three app/api/studio/people routes) are both compile errors when a value is
/// missing. Two are NOT, and are the ones to check by hand: `PERSON_KIND_ORDER` in PersonCard.tsx,
/// which decides what a reader sees, and the `PERSON_KINDS` in lib/sections/schema.ts with its
/// matching `PersonFilter` in lib/sections/resolve.ts, which cannot use `satisfies` because they
/// carry an extra "" for "no filter".
///
/// ⚠ A VALUE HERE IS PERMANENT. Postgres has `ALTER TYPE … ADD VALUE` and nothing that removes one:
/// dropping a value means creating a replacement type, rewriting every column that uses it and
/// dropping the old — with a table lock — so the list below only ever grows. Weigh a new group as a
/// decision that cannot be undone cheaply.
enum PersonKind {
  FACULTY
  SCIENTIST
  RESEARCHER
  STUDENT
  STAFF
  VISITOR
  ALUMNUS
  /// ── Appended, and appended DELIBERATELY AT THE END ───────────────────────
  /// Appending is a plain `ALTER TYPE … ADD VALUE`; placing it where it reads best in the roster
  /// would need `… BEFORE 'FACULTY'`, which is the same migration with one more way to get it wrong.
  /// Nothing on screen is ordered by this enum — `PERSON_KIND_ORDER` in components/site/PersonCard.tsx
  /// decides that, and it puts this group first.
  ///
  /// The Development Commissioner (Handicrafts): an office of the Ministry of Textiles, not a grade of
  /// Centre employment, which is why it is its own group rather than a `designation` string on STAFF.
  /// `designation` is free text and therefore unfilterable and unsortable; the roster groups, the
  /// people-showcase block's "only one group" picker and the studio board all work off `kind`.
  DC_HANDICRAFTS
}

model Person {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  kind        PersonKind
  designation String?
  department  String?
  bio         String?
  /// Structured rich-text document (Tiptap JSON). Rendered by components/RichText.tsx, never with
  /// dangerouslySetInnerHTML.
  bioRich     Json?

  email         String?
  phone         String?
  website       String?
  linkedin      String?
  googleScholar String?
  orcid         String?
  github        String?

  researchInterests String[] @default([])

  photoId      String?
  /// Optional per-screen framing for the person's photograph: which part of it, and optionally which photograph, at
  /// each of the six screen widths. Null means nobody has framed it — the overwhelmingly common case,
  /// which renders exactly as it always has. The shape and the mobile-first cascade are owned by
  /// lib/media/screens.ts and validated by Zod at the API boundary; Postgres checks nothing here, for
  /// the reason the crop migration gives at length — an out-of-range rectangle must degrade to "no
  /// crop" at render rather than surface to an editor as "something went wrong".
  photoScreens Json?
  /// Manual ordering inside a `kind` group. Ties break on `name` so the order is total and stable —
  /// an unstable sort renders a different list on every request and looks like data changing.
  sortOrder    Int     @default(0)
  isVisible    Boolean @default(true)

  /// An alumnus keeps their years; a current member leaves `endedOn` null.
  startedOn DateTime?
  endedOn   DateTime?

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  photo        MediaAsset?         @relation("PersonPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  projects     ProjectMember[]
  publications PublicationAuthor[]
  events       EventSpeaker[]

  @@index([kind, sortOrder])
  @@index([status])
  @@index([deletedAt])
  @@map("people")
}

// ═══════════════════════════════════════════════════════════════════════════
// Research, projects and publications
// ═══════════════════════════════════════════════════════════════════════════

model ResearchArea {
  id           String  @id @default(cuid())
  slug         String  @unique
  title        String
  summary      String?
  body         Json?
  /// Lucide icon name. Validated against the exported icon set at write time so a typo surfaces in
  /// the editor rather than as a blank square in production.
  icon         String?
  /// Literal OKLCH/hex accent for the interactive research graph ONLY. The rest of the site has one
  /// action colour (§1.1); this is a data-encoding channel in a visualisation, not a second accent.
  accentColor  String?
  coverId      String?
  /// Optional per-screen framing for the research area's cover: which part of it, and optionally which photograph, at
  /// each of the six screen widths. Null means nobody has framed it — the overwhelmingly common case,
  /// which renders exactly as it always has. The shape and the mobile-first cascade are owned by
  /// lib/media/screens.ts and validated by Zod at the API boundary; Postgres checks nothing here, for
  /// the reason the crop migration gives at length — an out-of-range rectangle must degrade to "no
  /// crop" at render rather than surface to an editor as "something went wrong".
  coverScreens Json?
  sortOrder    Int     @default(0)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cover        MediaAsset?   @relation("ResearchAreaCover", fields: [coverId], references: [id], onDelete: SetNull)
  projects     Project[]
  publications Publication[]

  @@index([status])
  @@index([deletedAt])
  @@map("research_areas")
}

enum ProjectStatus {
  PROPOSED
  ACTIVE
  COMPLETED
  ON_HOLD
}

model Project {
  id      String        @id @default(cuid())
  slug    String        @unique
  title   String
  tagline String?
  summary String?
  body    Json?
  state   ProjectStatus @default(ACTIVE)

  researchAreaId String?

  fundingBody     String?
  /// Stored as a string WITH its currency beside it. A numeric column would have to pick a currency
  /// and every grant that is not in it becomes wrong by exactly the exchange rate on an unknown day.
  fundingAmount   String?
  fundingCurrency String? @default("INR")

  startedOn DateTime?
  endedOn   DateTime?
  /// 0–100. Clamped on write; a progress bar that can read 140% is worse than no bar.
  progress  Int       @default(0)

  coverId      String?
  /// Optional per-screen framing for the project's cover: which part of it, and optionally which photograph, at
  /// each of the six screen widths. Null means nobody has framed it — the overwhelmingly common case,
  /// which renders exactly as it always has. The shape and the mobile-first cascade are owned by
  /// lib/media/screens.ts and validated by Zod at the API boundary; Postgres checks nothing here, for
  /// the reason the crop migration gives at length — an out-of-range rectangle must degrade to "no
  /// crop" at render rather than surface to an editor as "something went wrong".
  coverScreens Json?

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  isFeatured  Boolean       @default(false)
  sortOrder   Int           @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  researchArea ResearchArea?      @relation(fields: [researchAreaId], references: [id], onDelete: SetNull)
  cover        MediaAsset?        @relation("ProjectCover", fields: [coverId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  milestones   ProjectMilestone[]
  media        ProjectMedia[]
  files        ProjectFile[]
  publications Publication[]      @relation("ProjectPublications")
  partners     ProjectPartner[]
  faqs         ProjectFaq[]

  @@index([state, status])
  @@index([researchAreaId])
  @@index([deletedAt])
  @@map("projects")
}

model ProjectMember {
  projectId String
  personId  String
  role      String?
  position  Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([projectId, personId])
  @@index([projectId, position])
  @@map("project_members")
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  detail      String?
  dueOn       DateTime?
  completedOn DateTime?
  position    Int       @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  @@map("project_milestones")
}

model ProjectMedia {
  projectId    String
  assetId      String
  /// Optional per-screen framing for this gallery picture: which part of it, and optionally which photograph, at
  /// each of the six screen widths. Null means nobody has framed it — the overwhelmingly common case,
  /// which renders exactly as it always has. The shape and the mobile-first cascade are owned by
  /// lib/media/screens.ts and validated by Zod at the API boundary; Postgres checks nothing here, for
  /// the reason the crop migration gives at length — an out-of-range rectangle must degrade to "no
  /// crop" at render rather than surface to an editor as "something went wrong".
  assetScreens Json?
  position     Int     @default(0)
  caption      String?

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([projectId, assetId])
  @@index([projectId, position])
  @@map("project_media")
}

model ProjectFile {
  projectId String
  fileId    String
  position  Int    @default(0)

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file    FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([projectId, fileId])
  @@map("project_files")
}

model ProjectPartner {
  projectId String
  partnerId String
  position  Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([projectId, partnerId])
  @@map("project_partners")
}

model ProjectFaq {
  id        String @id @default(cuid())
  projectId String
  question  String
  answer    String
  position  Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  @@map("project_faqs")
}

/// What a publication IS, which decides its chip, its BibTeX entry type and how every citation style
/// sets its title. Adding one is: a value here, a migration, and the mirrors in
/// app/(site)/publications/filters.ts, app/studio/publications/, components/sections/
/// PublicationListSection.tsx, lib/citation.ts, lib/sections/ and the two studio routes.
///
/// ⚠ A VALUE HERE IS PERMANENT, for the reason spelled out on `PersonKind` above: Postgres can add an
/// enum value and cannot drop one without rewriting every column typed as it.
enum PublicationKind {
  JOURNAL_ARTICLE
  CONFERENCE_PAPER
  BOOK
  BOOK_CHAPTER
  PATENT
  DATASET
  SOFTWARE
  PREPRINT
  THESIS
  REPORT
  /// ── Appended, and appended DELIBERATELY AT THE END ───────────────────────
  /// Same reason as `PersonKind`: appending is `ALTER TYPE … ADD VALUE` and nothing more. Reading order
  /// is `PUBLICATION_KIND_ORDER` in app/(site)/publications/filters.ts, which files both of these with
  /// the other outreach material rather than at the bottom of the list.
  ///
  /// The Centre's dissemination output — a single sheet handed out at a cluster visit, and the
  /// saddle-stitched booklet that goes with a training programme. Without these the only home for
  /// either is REPORT, which files a two-sided leaflet under the same chip as a funded technical
  /// report; the two are different objects to a reader and to a citation.
  ///
  /// They are two values rather than one "outreach" value because they cite differently: a booklet is
  /// a bound work that carries an ISBN often enough to matter and has a real `@booklet` entry type in
  /// BibTeX, whereas a flyer has neither and becomes `@misc`. See `BIBTEX_ENTRY_TYPES` in
  /// lib/citation.ts.
  FLYER
  BOOKLET
}

model Publication {
  id       String          @id @default(cuid())
  slug     String          @unique
  kind     PublicationKind
  title    String
  abstract String?

  /// The authoritative author line, IN ORDER, exactly as printed. `PublicationAuthor` links the
  /// subset who are Centre people; this string is what a citation renders. Deriving the line from
  /// the links alone would drop every external co-author and silently misattribute the work.
  authorLine String

  venue     String? // journal or conference name
  publisher String?
  volume    String?
  issue     String?
  pages     String?
  year      Int
  month     Int?

  doi          String?
  isbn         String?
  issn         String?
  patentNumber String?
  arxivId      String?
  url          String?
  /// Verbatim BibTeX. Stored rather than generated so a record imported from a publisher keeps its
  /// canonical key; lib/citation.ts generates one only when this is empty.
  bibtex       String?

  pdfFileId String?
  keywords  String[] @default([])

  researchAreaId String?

  isFeatured  Boolean       @default(false)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  researchArea ResearchArea?       @relation(fields: [researchAreaId], references: [id], onDelete: SetNull)
  authors      PublicationAuthor[]
  projects     Project[]           @relation("ProjectPublications")

  @@index([year, kind])
  @@index([status])
  @@index([deletedAt])
  @@map("publications")
}

model PublicationAuthor {
  publicationId String
  personId      String
  position      Int    @default(0)

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  person      Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([publicationId, personId])
  @@index([publicationId, position])
  @@map("publication_authors")
}

// ═══════════════════════════════════════════════════════════════════════════
// Newsroom
// ═══════════════════════════════════════════════════════════════════════════

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  sortOrder   Int     @default(0)

  posts Post[]

  @@map("categories")
}

model Tag {
  id   String @id @default(cuid())
  slug String @unique
  name String

  posts  PostTag[]
  events EventTag[]

  @@map("tags")
}

model Post {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  subtitle String?
  excerpt  String?
  /// Tiptap JSON. See lib/richtext.ts — the same document renders in the CMS preview and on the site
  /// from ONE renderer, so "it looked different after publishing" cannot happen.
  body     Json?
  /// Optional MDX source for long-form pieces that need components. Mutually exclusive with `body`;
  /// the editor picks one mode per post and says which.
  mdx      String?

  coverId      String?
  /// Optional per-screen framing for the article's cover: which part of it, and optionally which photograph, at
  /// each of the six screen widths. Null means nobody has framed it — the overwhelmingly common case,
  /// which renders exactly as it always has. The shape and the mobile-first cascade are owned by
  /// lib/media/screens.ts and validated by Zod at the API boundary; Postgres checks nothing here, for
  /// the reason the crop migration gives at length — an out-of-range rectangle must degrade to "no
  /// crop" at render rather than surface to an editor as "something went wrong".
  coverScreens Json?
  authorId     String?
  categoryId   String?

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  publishAt   DateTime?
  unpublishAt DateTime?
  isFeatured  Boolean       @default(false)

  seoTitle       String?
  seoDescription String?
  seoNoIndex     Boolean @default(false)

  readingMinutes Int?
  viewCount      Int  @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cover    MediaAsset? @relation("PostCover", fields: [coverId], references: [id], onDelete: SetNull)
  author   User?       @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  category Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     PostTag[]

  /// Explicit editorial "read next" picks. Self-relation, so a post can name related posts without a
  /// tag-similarity heuristic guessing on its behalf.
  relatedTo   Post[] @relation("RelatedPosts")
  relatedFrom Post[] @relation("RelatedPosts")

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("posts")
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

// ═══════════════════════════════════════════════════════════════════════════
// Events
// ═══════════════════════════════════════════════════════════════════════════

enum EventMode {
  IN_PERSON
  ONLINE
  HYBRID
}

/// Named `CoeEvent` because `Event` is a DOM global; a Prisma model of that name produces a client
/// type that shadows it and turns every `addEventListener` handler parameter into the wrong type.
model CoeEvent {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  subtitle String?
  summary  String?
  body     Json?

  mode      EventMode @default(IN_PERSON)
  venue     String?
  address   String?
  latitude  Float?
  longitude Float?
  onlineUrl String?

  /// Both stored as absolute UTC instants. The site renders them in the Centre's timezone, which is
  /// a SETTING, not the viewer's locale — "the seminar is at 4pm" must mean one time for everyone.
  startsAt DateTime
  endsAt   DateTime?

  registrationUrl      String?
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  capacity             Int?
  isRegistrationOpen   Boolean   @default(false)

  coverId      String?
  /// Optional per-screen framing for the event's cover: which part of it, and optionally which photograph, at
  /// each of the six screen widths. Null means nobody has framed it — the overwhelmingly common case,
  /// which renders exactly as it always has. The shape and the mobile-first cascade are owned by
  /// lib/media/screens.ts and validated by Zod at the API boundary; Postgres checks nothing here, for
  /// the reason the crop migration gives at length — an out-of-range rectangle must degrade to "no
  /// crop" at render rather than surface to an editor as "something went wrong".
  coverScreens Json?

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  isFeatured  Boolean       @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cover         MediaAsset?         @relation("EventCover", fields: [coverId], references: [id], onDelete: SetNull)
  agenda        EventAgendaItem[]
  speakers      EventSpeaker[]
  media         EventMedia[]
  tags          EventTag[]
  registrations EventRegistration[]

  @@index([startsAt])
  @@index([status])
  @@index([deletedAt])
  @@map("events")
}

model EventAgendaItem {
  id       String    @id @default(cuid())
  eventId  String
  title    String
  detail   String?
  speaker  String?
  startsAt DateTime?
  endsAt   DateTime?
  position Int       @default(0)

  event CoeEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, position])
  @@map("event_agenda_items")
}

model EventSpeaker {
  eventId  String
  personId String
  role     String?
  position Int     @default(0)

  event  CoeEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([eventId, personId])
  @@map("event_speakers")
}

model EventMedia {
  eventId      String
  assetId      String
  /// Optional per-screen framing for this gallery picture: which part of it, and optionally which photograph, at
  /// each of the six screen widths. Null means nobody has framed it — the overwhelmingly common case,
  /// which renders exactly as it always has. The shape and the mobile-first cascade are owned by
  /// lib/media/screens.ts and validated by Zod at the API boundary; Postgres checks nothing here, for
  /// the reason the crop migration gives at length — an out-of-range rectangle must degrade to "no
  /// crop" at render rather than surface to an editor as "something went wrong".
  assetScreens Json?
  position     Int     @default(0)
  caption      String?

  event CoeEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([eventId, assetId])
  @@index([eventId, position])
  @@map("event_media")
}

model EventTag {
  eventId String
  tagId   String

  event CoeEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag   Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

